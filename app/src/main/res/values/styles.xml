<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#0f1412</item>
        <item name="android:colorAccent">#25d366</item>
        <item name="android:statusBarColor">#0f1412</item>
        <item name="android:navigationBarColor">#0f1412</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">#e8efe9</item>
        <item name="android:textColor">#e8efe9</item>
    </style>

    <color name="bg">#0f1412</color>
    <color name="muted">#8fa39a</color>
    <color name="accent">#25d366</color>
    <color name="err">#ff6b6b</color>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Btn">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">#e8efe9</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnPrimary" parent="Btn">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#0f1412</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
